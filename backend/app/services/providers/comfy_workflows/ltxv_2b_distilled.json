{
  "id": "ltxv_2b_distilled",
  "name": "LTX-Video 2B distilled (8 steps)",
  "description": "Distilled checkpoint: 8 steps, CFG 1 (settings taken from the 0.9.6-distilled config). Quickest option; motion quality is lower than Wan.",
  "family": "ltxv",
  "modes": [
    "t2v",
    "i2v"
  ],
  "fps": 24,
  "frame_multiple": 8,
  "max_seconds": 6,
  "sizes": {
    "16:9": [
      768,
      448
    ],
    "9:16": [
      448,
      768
    ],
    "1:1": [
      576,
      576
    ],
    "4:3": [
      672,
      512
    ],
    "3:4": [
      512,
      672
    ],
    "21:9": [
      896,
      384
    ]
  },
  "est_seconds": 150,
  "negative": "low quality, worst quality, deformed, distorted, disfigured, motion smear, motion artifacts, fused fingers, bad anatomy, weird hand, ugly",
