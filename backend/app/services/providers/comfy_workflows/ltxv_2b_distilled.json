      "node": "CheckpointLoaderSimple",
      "input": "ckpt_name",
      "folder": "models/checkpoints",
      "size_gb": 6.34,
      "candidates": [
        "ltxv-2b-0.9.6-distilled-04-25.safetensors",
        "ltxv-2b-0.9.8-distilled.safetensors",
        "ltxv-2b-0.9.8-distilled-fp8.safetensors"
